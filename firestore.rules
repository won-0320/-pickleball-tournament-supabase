rules_version = '2';

// 모든 클라이언트 직접 접근을 차단한다. 이 앱은 클라이언트 Firebase SDK를
// 전혀 사용하지 않으며, 모든 읽기/쓰기는 서버(Next.js Server Action)에서
// firebase-admin 서비스 계정을 통해서만 수행된다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
